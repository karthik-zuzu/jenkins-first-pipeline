
pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building website'
                sh 'test -f index.html'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing website'
                sh 'grep -q "<h1>" index.html'
            }
        }

        stage('Publish') {
            steps {
                echo 'Publishing website artifact'

                archiveArtifacts artifacts: 'index.html',
                                 fingerprint: true
            }
        }
    }
}

