
pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building website'
                sh 'test -f index.html'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing website'
                sh 'grep -q "Welcome to My DevOps Project" index.html'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying website'
                sh 'cp index.html /var/www/html/myapp/index.html'
            }
        }
    }
}
